# Calculate descriptive statistics for the main engagement variables.
engagement_summary <- data |>
summarise(
across(
c(likeCount, commentCount, shareCount, videoplayCount, social_engagement),
list(
Mean = ~ mean(., na.rm = TRUE),
Median = ~ median(., na.rm = TRUE),
Mode = ~ {
x <- .[!is.na(.)]
ux <- unique(x)
ux[which.max(tabulate(match(x, ux)))]
},
Q1 = ~ quantile(., 0.25, na.rm = TRUE),
Q2 = ~ quantile(., 0.50, na.rm = TRUE),
Q3 = ~ quantile(., 0.75, na.rm = TRUE),
SD = ~ sd(., na.rm = TRUE),
IQR = ~ IQR(., na.rm = TRUE)
),
.names = "{.col}__{.fn}"
)
) |>
pivot_longer(
everything(),
names_to = c("Variable", "Statistic"),
names_sep = "__"
) |>
pivot_wider(
names_from = Variable,
values_from = value
) |>
select(Statistic, everything())
View(engagement_summary)

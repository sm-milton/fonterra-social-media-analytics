# Calculate descriptive statistics for the main engagement variables.
engagement_summary <- data |>
summarise(
across(
c(likeCount, commentCount, shareCount, videoplayCount, social_engagement),
list(
n = ~ sum(!is.na(.)),
mean = ~ mean(., na.rm = TRUE),
median = ~ median(., na.rm = TRUE),
sd = ~ sd(., na.rm = TRUE),
min = ~ min(., na.rm = TRUE),
max = ~ max(., na.rm = TRUE)
),
.names = "{.col}_{.fn}"
)
)
kable(
engagement_summary,
digits = 2,
caption = "Descriptive statistics for engagement variables"
)
